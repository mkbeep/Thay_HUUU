# Expo Environment Configuration
# Force LAN connection instead of localhost

# Set connection type to LAN
EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.12

# API Configuration
# Thay YOUR_LOCAL_IP bằng IP máy tính của bạn (chạy ipconfig trên Windows)
API_URL=http://192.168.1.12:3000/api/v1

# Bản web khách (Expo Web — `cd App && npm run web`, cổng thường 8081). Trùng CUSTOMER_WEB_BASE_URL backend khi in QR.
CUSTOMER_WEB_BASE_URL=http://192.168.1.12:8081
