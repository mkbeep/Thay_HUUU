{
  "name": "restaurant-backend",
  "version": "1.0.0",
  "description": "Restaurant Management System Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/infrastructure/database/seeders/index.ts",
    "seed:admin": "ts-node scripts/seed-admin.ts",
    "seed:tables": "ts-node scripts/seed-tables.ts",
    "seed:50foods": "ts-node scripts/seed-50-foods.ts",
    "seed:foods-firebase": "ts-node scripts/seed-foods-with-firebase-images.ts",
    "seed:foods-backend": "ts-node scripts/seed-foods-backend-images.ts",
    "seed:foods-cloudinary": "cross-env IMAGE_PROVIDER=cloudinary ts-node scripts/seed-foods-backend-images.ts",
    "seed:firebase-full": "ts-node scripts/seed-all-data.ts",
    "seed:ancillary": "ts-node scripts/seed-ancillary.ts",
    "upload:images": "ts-node scripts/upload-menu-images.ts",
    "upload:images:cloudinary": "ts-node scripts/upload-menu-images.ts",
    "verify:images": "ts-node scripts/verify-images.ts",
    "clear:foods": "ts-node scripts/clear-foods.ts",
    "clear:orders": "ts-node scripts/clear-orders.ts",
    "check:all": "ts-node scripts/check-all-data.ts",
    "check:tables": "ts-node scripts/check-firebase-tables.ts",
    "check:food": "ts-node scripts/check-food-data.ts",
    "test:images": "ts-node scripts/test-image-urls.ts",
    "generate-qr": "ts-node scripts/generate-qr-simple.ts",
    "generate-qr:advanced": "ts-node scripts/generate-qr-from-firebase.ts",
    "generate-qr:old": "ts-node scripts/generate-qr-codes.ts",
    "test": "jest",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "restaurant",
    "api",
    "firebase",
    "jwt",
    "notification"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/socket.io": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^3.0.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
