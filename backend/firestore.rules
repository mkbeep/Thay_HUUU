rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isManager() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }
    
    function isStaff() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }
    
    function isStaffOrHigher() {
      return isStaff() || isManager() || isAdmin();
    }
    
    // Users collection - only admins can manage
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Dining tables - staff can read, admin/manager can write
    match /dining_table/{tableId} {
      allow read: if true; // Public read for QR scanning
      allow write: if isStaffOrHigher();
    }
    
    // Table sessions - staff can read/write
    match /table_session/{sessionId} {
      allow read: if true; // Public read for customers
      allow create: if true; // Allow customers to start sessions
      allow update, delete: if isStaffOrHigher();
    }
    
    // Food menu - public read, staff can write
    match /food/{foodId} {
      allow read: if true; // Public read
      allow write: if isStaffOrHigher();
    }
    
    // Food images - public read, staff can write
    match /food_image/{imageId} {
      allow read: if true; // Public read
      allow write: if isStaffOrHigher();
    }
    
    // Orders - customers can create, staff can manage
    match /orders/{orderId} {
      allow read: if true; // Allow customers to read their orders
      allow create: if true; // Allow customers to create orders
      allow update, delete: if isStaffOrHigher();
    }
    
    // Order items - same as orders
    match /order_item/{itemId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaffOrHigher();
    }
    
    // Support requests - customers can create, staff can manage
    match /support_request/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaffOrHigher();
    }
  }
}
