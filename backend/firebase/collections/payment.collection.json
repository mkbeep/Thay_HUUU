{
  "collectionName": "payment",
  "description": "Thanh toán tách bảng (nếu dùng) — khớp domain Payment.ts; hiện flow QR có thể chỉ cập nhật orders.payment_*",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "order_id": { "type": "string", "description": "FK → orders.id", "required": true, "indexed": true },
    "payment_method": {
      "type": "string",
      "enum": ["cash", "credit_card", "debit_card", "mobile_payment", "bank_transfer", "qr"],
      "required": true,
      "indexed": true
    },
    "amount": { "type": "number", "required": true },
    "status": {
      "type": "string",
      "enum": ["pending", "processing", "completed", "failed", "refunded"],
      "required": true,
      "indexed": true,
      "default": "pending"
    },
    "transaction_id": { "type": "string", "required": false, "indexed": true },
    "payment_details": { "type": "map", "required": false },
    "processed_by": { "type": "string", "description": "FK → users", "required": false },
    "processed_at": { "type": "timestamp", "required": false },
    "created_at": { "type": "timestamp", "required": true, "indexed": true },
    "updated_at": { "type": "timestamp", "required": true }
  },
  "indexes": [
    { "fields": ["order_id", "status"], "queryScope": "COLLECTION" },
    { "fields": ["status", "created_at"], "queryScope": "COLLECTION" }
  ]
}
