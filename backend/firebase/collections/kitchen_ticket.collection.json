{
  "collectionName": "kitchen_ticket",
  "description": "Phiếu bếp — field snake_case, FK khớp order_item / food",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "order_item_id": { "type": "string", "description": "FK → order_item.id", "required": true, "indexed": true },
    "food_id": { "type": "string", "description": "FK → food.id", "required": true, "indexed": true },
    "quantity": { "type": "number", "required": true },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "cancelled"],
      "required": true,
      "indexed": true,
      "default": "pending"
    },
    "assigned_chef_id": { "type": "string", "description": "FK → users", "required": false, "indexed": true },
    "started_at": { "type": "timestamp", "required": false },
    "finished_at": { "type": "timestamp", "required": false },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high", "urgent"],
      "default": "normal",
      "required": false
    },
    "note": { "type": "string", "required": false },
    "created_at": { "type": "timestamp", "required": true, "indexed": true }
  },
  "indexes": [
    { "fields": ["status", "created_at"], "queryScope": "COLLECTION" },
    { "fields": ["assigned_chef_id", "status"], "queryScope": "COLLECTION" },
    { "fields": ["order_item_id"], "queryScope": "COLLECTION" }
  ]
}
