{
  "collectionName": "orders",
  "description": "Đơn hàng — khớp domain/entities/Order.ts + OrderRepository + payload app (OrderContext)",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "order_number": {
      "type": "string",
      "description": "ORD-YYYYMMDD-XXXX (generateOrderNumber)",
      "required": true,
      "indexed": true
    },
    "table_session_id": {
      "type": "string",
      "description": "FK logic → table_session.id (hoặc legacy: số bàn string)",
      "required": false,
      "indexed": true
    },
    "customer_id": {
      "type": "string",
      "description": "FK → users (JWT) — khách không đăng nhập thì có thể null",
      "required": false,
      "indexed": true
    },
    "staff_id": {
      "type": "string",
      "description": "Nhân viên xử lý (nếu có)",
      "required": false,
      "indexed": false
    },
    "order_type": {
      "type": "string",
      "enum": ["dine_in", "takeaway", "delivery"],
      "required": true,
      "indexed": true,
      "default": "dine_in"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "confirmed", "preparing", "ready", "served", "completed", "cancelled"],
      "required": true,
      "indexed": true,
      "default": "pending"
    },
    "payment_status": {
      "type": "string",
      "enum": ["unpaid", "payment_pending_confirmation", "paid"],
      "required": false,
      "indexed": true,
      "default": "unpaid"
    },
    "payment_method": {
      "type": "string",
      "enum": ["qr", "cash", "card", "e_wallet"],
      "required": false,
      "indexed": false
    },
    "payment_requested_at": { "type": "timestamp", "required": false },
    "paid_at": { "type": "timestamp", "required": false },
    "subtotal": { "type": "number", "required": false, "indexed": false },
    "tax_amount": { "type": "number", "required": false, "default": 0 },
    "discount_amount": { "type": "number", "required": false, "default": 0 },
    "total_amount": { "type": "number", "required": false, "indexed": false },
    "notes": { "type": "string", "required": false },
    "items": {
      "type": "array",
      "description": "Tùy bản triển khai: có thể embed tạm từ POST /orders; chi tiết chuẩn nên ở order_item",
      "required": false,
      "itemType": "map"
    },
    "created_at": { "type": "timestamp", "required": true, "indexed": true },
    "updated_at": { "type": "timestamp", "required": true, "indexed": false },
    "completed_at": { "type": "timestamp", "required": false, "indexed": false }
  },
  "indexes": [
    { "fields": ["table_session_id", "status"], "queryScope": "COLLECTION" },
    { "fields": ["status", "created_at"], "queryScope": "COLLECTION" },
    { "fields": ["order_number"], "queryScope": "COLLECTION" },
    { "fields": ["payment_status", "created_at"], "queryScope": "COLLECTION" }
  ]
}
