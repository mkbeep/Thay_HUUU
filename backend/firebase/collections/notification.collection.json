{
  "collectionName": "notification",
  "description": "Thông báo — khớp Notification entity + NotificationRepository (user_id, is_read, created_at)",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "user_id": { "type": "string", "description": "Người nhận (query findByUserId)", "required": true, "indexed": true },
    "type": {
      "type": "string",
      "enum": [
        "order_created",
        "order_updated",
        "order_ready",
        "order_completed",
        "table_request",
        "staff_call",
        "payment_request",
        "system_alert",
        "promotion"
      ],
      "required": true,
      "indexed": true
    },
    "title": { "type": "string", "required": true },
    "message": { "type": "string", "required": true },
    "data": { "type": "map", "description": "Payload (order_id, …)", "required": false },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high", "urgent"],
      "required": true,
      "indexed": false,
      "default": "normal"
    },
    "is_read": { "type": "boolean", "required": true, "indexed": true, "default": false },
    "read_at": { "type": "timestamp", "required": false },
    "created_at": { "type": "timestamp", "required": true, "indexed": true },
    "expires_at": { "type": "timestamp", "required": false, "indexed": true }
  },
  "indexes": [
    { "fields": ["user_id", "is_read"], "queryScope": "COLLECTION" },
    { "fields": ["type", "created_at"], "queryScope": "COLLECTION" }
  ],
  "notes": [
    "Không dùng: targetUserIds, targetRoles, relatedEntityType camelCase như bản spec cũ."
  ]
}
