{
  "collectionName": "user_role",
  "description": "user ↔ role — khớp userSeeder (user_id, role_id, assigned_at, assigned_by)",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "user_id": { "type": "string", "description": "FK → users.id", "required": true, "indexed": true },
    "role_id": { "type": "string", "description": "FK → role.id", "required": true, "indexed": true },
    "assigned_at": { "type": "timestamp", "required": true, "indexed": true },
    "assigned_by": { "type": "string", "description": "users.id hoặc 'system'", "required": false }
  },
  "indexes": [
    { "fields": ["user_id", "role_id"], "queryScope": "COLLECTION", "unique": true },
    { "fields": ["user_id"], "queryScope": "COLLECTION" },
    { "fields": ["role_id"], "queryScope": "COLLECTION" }
  ]
}
