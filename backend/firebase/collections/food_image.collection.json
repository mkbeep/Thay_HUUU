{
  "collectionName": "food_image",
  "description": "Ảnh món — khớp FoodRepository / foodSeeder (where food_id)",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "food_id": { "type": "string", "description": "FK → food.id", "required": true, "indexed": true },
    "image_url": { "type": "string", "required": true, "indexed": false },
    "is_primary": { "type": "boolean", "required": true, "indexed": true, "default": false },
    "display_order": { "type": "number", "required": false, "default": 0 },
    "uploaded_at": { "type": "timestamp", "required": true, "indexed": false }
  },
  "indexes": [
    { "fields": ["food_id", "is_primary"], "queryScope": "COLLECTION" },
    { "fields": ["food_id", "display_order"], "queryScope": "COLLECTION" }
  ]
}
