{
  "collectionName": "inventory",
  "description": "Nguyên liệu / tồn kho — khớp Inventory entity + inventorySeeder",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "item_name": { "type": "string", "required": true, "indexed": true },
    "description": { "type": "string", "required": false },
    "category": { "type": "string", "required": true, "indexed": true },
    "current_quantity": { "type": "number", "required": true, "indexed": true },
    "unit": {
      "type": "string",
      "enum": ["kg", "g", "l", "ml", "piece", "pack"],
      "required": true
    },
    "minimum_quantity": { "type": "number", "required": true },
    "reorder_quantity": { "type": "number", "required": true },
    "unit_cost": { "type": "number", "required": true },
    "supplier": { "type": "string", "required": false },
    "linked_food_ids": {
      "type": "array",
      "itemType": "string",
      "description": "Tùy chọn: id món food liên quan (tên NL ≠ tên món)",
      "required": false
    },
    "last_restocked_at": { "type": "timestamp", "required": false },
    "created_at": { "type": "timestamp", "required": true },
    "updated_at": { "type": "timestamp", "required": true }
  },
  "indexes": [
    { "fields": ["category", "current_quantity"], "queryScope": "COLLECTION" },
    { "fields": ["item_name"], "queryScope": "COLLECTION" }
  ]
}
