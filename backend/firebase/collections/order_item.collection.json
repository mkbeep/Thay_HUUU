{
  "collectionName": "order_item",
  "description": "Dòng món trong đơn — khớp domain OrderItem + OrderRepository (where order_id)",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "order_id": {
      "type": "string",
      "description": "FK → orders.id",
      "required": true,
      "indexed": true
    },
    "food_id": {
      "type": "string",
      "description": "FK → food.id",
      "required": true,
      "indexed": true
    },
    "quantity": { "type": "number", "required": true },
    "unit_price": { "type": "number", "description": "Giá tại lúc đặt (VNĐ)", "required": true },
    "subtotal": {
      "type": "number",
      "description": "quantity * unit_price (domain OrderItem)",
      "required": true
    },
    "special_instructions": {
      "type": "string",
      "description": "Ghi chú món (app gửi notes → map sang đây khi persist)",
      "required": false
    },
    "status": {
      "type": "string",
      "enum": ["pending", "preparing", "ready", "served", "cancelled"],
      "required": true,
      "indexed": true,
      "default": "pending"
    },
    "created_at": { "type": "timestamp", "required": true, "indexed": true },
    "updated_at": { "type": "timestamp", "required": true, "indexed": false }
  },
  "indexes": [
    { "fields": ["order_id", "status"], "queryScope": "COLLECTION" },
    { "fields": ["food_id", "created_at"], "queryScope": "COLLECTION" }
  ]
}
