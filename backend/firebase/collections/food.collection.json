{
  "collectionName": "food",
  "description": "Món ăn — khớp domain Food + foodSeeder / FoodRepository",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "name": { "type": "string", "required": true, "indexed": false },
    "description": { "type": "string", "required": false, "indexed": false },
    "category": {
      "type": "string",
      "description": "FoodCategory enum (tiếng Anh)",
      "required": true,
      "indexed": true,
      "enum": ["appetizer", "main_course", "dessert", "beverage", "side_dish", "special"]
    },
    "base_price": { "type": "number", "description": "Giá (VNĐ)", "required": true },
    "is_available": { "type": "boolean", "required": true, "indexed": true, "default": true },
    "preparation_time": { "type": "number", "description": "Phút", "required": false, "default": 0 },
    "calories": { "type": "number", "required": false },
    "is_vegetarian": { "type": "boolean", "required": false, "default": false },
    "is_spicy": { "type": "boolean", "required": false, "default": false },
    "allergens": { "type": "array", "itemType": "string", "required": false },
    "created_at": { "type": "timestamp", "required": true, "indexed": true },
    "updated_at": { "type": "timestamp", "required": true, "indexed": false }
  },
  "indexes": [
    { "fields": ["category", "is_available"], "queryScope": "COLLECTION" },
    { "fields": ["is_available", "created_at"], "queryScope": "COLLECTION" }
  ],
  "notes": [
    "Không dùng: price, inStock, createdAt — đã đổi sang base_price, is_available, created_at"
  ]
}
