{
  "collectionName": "food",
  "description": "Collection chứa thông tin các món ăn trong menu",
  "fields": {
    "id": {
      "type": "string",
      "description": "ID tự động tạo bởi Firestore",
      "required": true,
      "indexed": true
    },
    "name": {
      "type": "string",
      "description": "Tên món ăn",
      "required": true,
      "indexed": false
    },
    "description": {
      "type": "string",
      "description": "Mô tả chi tiết món ăn",
      "required": true,
      "indexed": false
    },
    "price": {
      "type": "number",
      "description": "Giá món ăn (VNĐ)",
      "required": true,
      "indexed": false
    },
    "category": {
      "type": "string",
      "description": "Danh mục món ăn",
      "required": true,
      "indexed": true,
      "enum": ["Khai vị", "Món chính", "Tráng miệng", "Đồ uống", "Đặc biệt"]
    },
    "inStock": {
      "type": "boolean",
      "description": "Còn hàng (available)",
      "required": true,
      "indexed": true,
      "default": true
    },
    "createdAt": {
      "type": "timestamp",
      "description": "Thời gian tạo",
      "required": true,
      "indexed": true
    },
    "updatedAt": {
      "type": "timestamp",
      "description": "Thời gian cập nhật",
      "required": true,
      "indexed": false
    }
  },
  "indexes": [
    {
      "fields": ["category", "inStock"],
      "queryScope": "COLLECTION"
    },
    {
      "fields": ["inStock", "createdAt"],
      "queryScope": "COLLECTION"
    }
  ],
  "notes": [
    "Topping được quản lý trong collection riêng hoặc subcollection",
    "Độ cay (spiceLevel) là lựa chọn của khách khi đặt, không lưu trong food",
    "Không cần: allergens, ingredients, preparationTime, isVegetarian, isSpicy - không hiển thị trong UI"
  ]
}
