{
  "collectionName": "food_topping",
  "description": "Topping dùng chung — collection gốc (seed-ancillary.ts, foodSeeder), không phải subcollection food/{id}/toppings",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "name": { "type": "string", "required": true },
    "description": { "type": "string", "required": false },
    "price": { "type": "number", "required": true },
    "is_available": { "type": "boolean", "required": true, "default": true },
    "created_at": { "type": "timestamp", "required": true },
    "updated_at": { "type": "timestamp", "required": true }
  },
  "indexes": [{ "fields": ["is_available", "name"], "queryScope": "COLLECTION" }]
}
