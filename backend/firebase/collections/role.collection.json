{
  "collectionName": "role",
  "description": "Collection quản lý vai trò người dùng",
  "fields": {
    "id": {
      "type": "string",
      "description": "ID tự động tạo bởi Firestore",
      "required": true,
      "indexed": true
    },
    "name": {
      "type": "string",
      "description": "Tên vai trò",
      "required": true,
      "indexed": true,
      "unique": true,
      "enum": ["admin", "manager", "chef", "waiter", "cashier"]
    },
    "displayName": {
      "type": "string",
      "description": "Tên hiển thị tiếng Việt",
      "required": true,
      "indexed": false
    },
    "permissions": {
      "type": "array",
      "description": "Danh sách quyền",
      "required": true,
      "indexed": false,
      "itemType": "string"
    },
    "description": {
      "type": "string",
      "description": "Mô tả vai trò",
      "required": false,
      "indexed": false
    },
    "createdAt": {
      "type": "timestamp",
      "description": "Thời gian tạo",
      "required": true,
      "indexed": false
    },
    "updatedAt": {
      "type": "timestamp",
      "description": "Thời gian cập nhật",
      "required": true,
      "indexed": false
    }
  },
  "indexes": [
    {
      "fields": ["name"],
      "queryScope": "COLLECTION",
      "unique": true
    }
  ]
}
