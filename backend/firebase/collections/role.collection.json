{
  "collectionName": "role",
  "description": "Vai trò — khớp roleSeeder.ts (role_name, permissions)",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "role_name": {
      "type": "string",
      "description": "Slug: admin | manager | staff | chef | customer",
      "required": true,
      "indexed": true,
      "unique": true
    },
    "description": { "type": "string", "required": false },
    "permissions": { "type": "array", "itemType": "string", "required": true },
    "created_at": { "type": "timestamp", "required": true },
    "updated_at": { "type": "timestamp", "required": true }
  },
  "indexes": [{ "fields": ["role_name"], "queryScope": "COLLECTION", "unique": true }]
}
