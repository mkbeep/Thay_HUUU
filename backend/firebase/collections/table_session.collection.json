{
  "collectionName": "table_session",
  "description": "Phiên phục vụ tại một bàn — khớp TableRepository.createSession / findActiveSessionByTableId",
  "fields": {
    "id": {
      "type": "string",
      "description": "Document ID Firestore",
      "required": true,
      "indexed": true
    },
    "table_id": {
      "type": "string",
      "description": "FK → dining_table.id",
      "required": true,
      "indexed": true
    },
    "session_code": {
      "type": "string",
      "description": "Mã phiên hiển thị (UUID rút gọn)",
      "required": true,
      "indexed": false
    },
    "customer_count": {
      "type": "number",
      "description": "Số khách (POST /tables/:id/session body customer_count)",
      "required": true,
      "indexed": false,
      "default": 1
    },
    "started_at": {
      "type": "timestamp",
      "description": "Bắt đầu phiên",
      "required": true,
      "indexed": true
    },
    "ended_at": {
      "type": "timestamp",
      "description": "Kết thúc phiên (PATCH .../session/:id/end)",
      "required": false,
      "indexed": true
    },
    "is_active": {
      "type": "boolean",
      "description": "true = đang phục vụ; false sau khi endSession",
      "required": true,
      "indexed": true,
      "default": true
    },
    "created_by": {
      "type": "string",
      "description": "FK → users.id (JWT staff) hoặc undefined khi khách tạo phiên",
      "required": false,
      "indexed": false
    }
  },
  "indexes": [
    {
      "fields": ["table_id", "is_active"],
      "queryScope": "COLLECTION",
      "note": "Query findActiveSessionByTableId"
    },
    {
      "fields": ["is_active", "started_at"],
      "queryScope": "COLLECTION"
    }
  ],
  "removedFromSpec": [
    "Không dùng: tableId, startTime, endTime, status (active/completed), createdBy, customerCount, totalRevenue — đã thay bằng field snake_case và is_active/ended_at"
  ]
}
