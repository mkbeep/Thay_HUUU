{
  "collectionName": "dining_table",
  "description": "Bàn ăn — khớp tableSeeder.ts + TableRepository (snake_case)",
  "fields": {
    "id": {
      "type": "string",
      "description": "Document ID Firestore",
      "required": true,
      "indexed": true
    },
    "table_number": {
      "type": "string",
      "description": "Mã bàn hiển thị & QR (T01, G03, V02, …) — luôn string trong DB",
      "required": true,
      "indexed": true,
      "unique": true
    },
    "capacity": {
      "type": "number",
      "description": "Số chỗ",
      "required": true,
      "indexed": false
    },
    "status": {
      "type": "string",
      "description": "TableStatus enum",
      "required": true,
      "indexed": true,
      "enum": ["available", "occupied", "reserved", "cleaning", "out_of_service"],
      "default": "available"
    },
    "location": {
      "type": "string",
      "description": "Khu vực",
      "required": false,
      "indexed": false
    },
    "qr_code": {
      "type": "string",
      "description": "Tham chiếu/placeholder QR (URL đầy đủ thường build từ API)",
      "required": false,
      "indexed": false
    },
    "created_at": {
      "type": "timestamp",
      "required": true,
      "indexed": false
    },
    "updated_at": {
      "type": "timestamp",
      "required": true,
      "indexed": false
    }
  },
  "indexes": [
    {
      "fields": ["status", "table_number"],
      "queryScope": "COLLECTION"
    },
    {
      "fields": ["table_number"],
      "queryScope": "COLLECTION",
      "unique": true
    }
  ],
  "notes": [
    "Không lưu currentSessionId trên document bàn — phiên active resolve qua table_session (where table_id + is_active)."
  ]
}
