{
  "collectionName": "dining_table",
  "description": "Collection quản lý bàn ăn trong nhà hàng",
  "fields": {
    "id": {
      "type": "string",
      "description": "ID tự động tạo bởi Firestore",
      "required": true,
      "indexed": true
    },
    "tableNumber": {
      "type": "number",
      "description": "Số bàn (unique)",
      "required": true,
      "indexed": true,
      "unique": true
    },
    "capacity": {
      "type": "number",
      "description": "Số lượng chỗ ngồi",
      "required": true,
      "indexed": false
    },
    "status": {
      "type": "string",
      "description": "Trạng thái bàn",
      "required": true,
      "indexed": true,
      "enum": ["available", "occupied", "reserved", "cleaning"],
      "default": "available"
    },
    "location": {
      "type": "string",
      "description": "Vị trí bàn trong nhà hàng",
      "required": false,
      "indexed": false
    },
    "qrCode": {
      "type": "string",
      "description": "URL mã QR của bàn",
      "required": false,
      "indexed": false
    },
    "currentSessionId": {
      "type": "string",
      "description": "ID phiên hiện tại (reference to table_session)",
      "required": false,
      "indexed": true
    },
    "createdAt": {
      "type": "timestamp",
      "description": "Thời gian tạo",
      "required": true,
      "indexed": false
    },
    "updatedAt": {
      "type": "timestamp",
      "description": "Thời gian cập nhật",
      "required": true,
      "indexed": false
    }
  },
  "indexes": [
    {
      "fields": ["status", "tableNumber"],
      "queryScope": "COLLECTION"
    },
    {
      "fields": ["tableNumber"],
      "queryScope": "COLLECTION",
      "unique": true
    },
    {
      "fields": ["status"],
      "queryScope": "COLLECTION"
    }
  ]
}
