{
  "collectionName": "promotion",
  "description": "Khuyến mãi — khớp promotionSeeder.ts (snake_case)",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "code": { "type": "string", "required": true, "indexed": true, "unique": true },
    "name": { "type": "string", "required": true },
    "description": { "type": "string", "required": true },
    "type": {
      "type": "string",
      "enum": ["percentage", "fixed_amount", "buy_x_get_y", "free_item", "combo"],
      "required": true,
      "indexed": true
    },
    "discount_value": { "type": "number", "required": true },
    "min_order_amount": { "type": "number", "required": false },
    "max_discount_amount": { "type": "number", "required": false },
    "start_date": { "type": "timestamp", "required": true, "indexed": true },
    "end_date": { "type": "timestamp", "required": true, "indexed": true },
    "usage_limit": { "type": "number", "required": false },
    "usage_count": { "type": "number", "required": true, "default": 0 },
    "is_active": { "type": "boolean", "required": true, "indexed": true, "default": true },
    "created_at": { "type": "timestamp", "required": true },
    "updated_at": { "type": "timestamp", "required": true }
  },
  "indexes": [
    { "fields": ["code"], "queryScope": "COLLECTION", "unique": true },
    { "fields": ["is_active", "start_date", "end_date"], "queryScope": "COLLECTION" },
    { "fields": ["type", "is_active"], "queryScope": "COLLECTION" }
  ]
}
