{
  "collectionName": "users",
  "description": "Người dùng — khớp userSeeder.ts + User entity + UserRepository",
  "fields": {
    "id": { "type": "string", "required": true, "indexed": true },
    "email": { "type": "string", "required": true, "indexed": true, "unique": true },
    "password": { "type": "string", "description": "bcrypt hash", "required": true, "indexed": false },
    "full_name": { "type": "string", "required": true },
    "phone_number": { "type": "string", "required": false },
    "avatar_url": { "type": "string", "required": false },
    "is_active": { "type": "boolean", "required": true, "indexed": true, "default": true },
    "email_verified": { "type": "boolean", "required": true, "default": false },
    "last_login": { "type": "timestamp", "required": false },
    "fcm_token": { "type": "string", "required": false },
    "created_at": { "type": "timestamp", "required": true, "indexed": true },
    "updated_at": { "type": "timestamp", "required": true }
  },
  "indexes": [
    { "fields": ["email"], "queryScope": "COLLECTION", "unique": true },
    { "fields": ["is_active", "created_at"], "queryScope": "COLLECTION" }
  ],
  "notes": [
    "Vai trò không lưu role_id trên user — dùng collection user_role.",
    "Không dùng: displayName, userName, passwordHash, status (active/inactive) như spec cũ."
  ]
}
